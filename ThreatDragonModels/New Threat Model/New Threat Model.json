              "threats": [
                {
                  "id": "39a6f337-18a0-444a-8921-c852f5457b20",
                  "title": "Feedback Data Tampering",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "Tampering",
                  "description": "Feedback comments, and other relevant data, from the web browser may be intercepted and tampered by an attacker. Input data verification failure can lead to a lot of exploitable issues.",
                  "mitigation": "Verify any incoming paths, and how they structure and formatted the data. The incoming data must be checked with an approved list of valid input data with server-side input validation, json/schema validation, and enconding to prevent cross-site scripting.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 12,
                  "score": ""
                },
                {
                  "id": "03e0882f-6350-4bdd-b11b-dd4670002967",
                  "title": "Sensitive Feedback Data Disclosure",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "Information disclosure",
                  "description": "Any input data from the web browser may be sniffed by an attacker. It may be an open disclosure of information leading to privacy and compliance issues; moreover, that incoming can have data containing sensitive information that can be exploited to manipulate the system.",
                  "mitigation": "Encrypt the incoming data with HTTPS, and add field-level encryption for very sensitive input fields.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 13,
                  "score": ""
                }
              ],
